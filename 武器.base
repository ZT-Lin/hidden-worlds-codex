views:
  - type: table
    name: 表格
    filters:
      and:
        - file.folder == "武器"
    order:
      - file.name
      - file.fullname
      - 英文
      - 武器类别
      - 伤害
      - 伤害类型
      - 武器属性
      - 重量（磅）
      - 价格
      - file.ctime
    sort:
      - property: 重量
        direction: DESC
