views:
  - type: table
    name: 表格
    filters:
      and:
        - file.inFolder("职业/牧师领域/神力")
    order:
      - file.name
      - 笔记类别
    sort:
      - property: 笔记类别
        direction: ASC
      - property: 英文
        direction: ASC
      - property: 维度
        direction: ASC
      - property: 伤害类型
        direction: ASC
      - property: 武器类别
        direction: DESC
    columnSize:
      file.name: 115
      note.tags: 370
