views:
  - type: table
    name: 表格
    filters:
      and:
        - 维度 == link("感知")
    order:
      - file.name
      - 兼职条件
    sort:
      - property: 施法职业
        direction: ASC
      - property: 笔记类别
        direction: ASC
      - property: 英文
        direction: ASC
      - property: 维度
        direction: ASC
      - property: 伤害类型
        direction: ASC
      - property: 武器类别
        direction: DESC
    columnSize:
      file.name: 115
      note.熟练技能: 597
