views:
  - type: table
    name: 表格
    order:
      - file.name
      - 笔记类别
      - aliases
      - 英文
    sort:
      - property: 英文
        direction: ASC
      - property: 维度
        direction: ASC
      - property: 伤害类型
        direction: ASC
      - property: 武器类别
        direction: DESC
    columnSize:
      file.name: 115
      note.tags: 370
