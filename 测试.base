views:
  - type: table
    name: 表格
    filters:
      and:
        - file.folder == "武器"
    order:
      - file.name
      - 武器类别
      - 武器属性
    sort:
      - property: 武器类别
        direction: ASC
      - property: 兼职条件
        direction: ASC
      - property: 施法职业
        direction: ASC
      - property: 笔记类别
        direction: ASC
      - property: 英文
        direction: ASC
      - property: 维度
        direction: ASC
      - property: 伤害类型
        direction: ASC
    columnSize:
      file.name: 115
      note.熟练技能: 597
