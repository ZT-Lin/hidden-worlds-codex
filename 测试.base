views:
  - type: table
    name: 表格
    filters:
      and:
        - file.folder == "职业"
    order:
      - file.name
      - 笔记类别
      - 生命骰
      - 豁免项
      - 施法职业
      - 熟练工具
      - 熟练护甲
      - 熟练技能
      - 熟练武器
      - 子职业
    sort:
      - property: 施法职业
        direction: ASC
      - property: 笔记类别
        direction: ASC
      - property: 英文
        direction: ASC
      - property: 维度
        direction: ASC
      - property: 伤害类型
        direction: ASC
      - property: 武器类别
        direction: DESC
    columnSize:
      file.name: 115
      note.熟练技能: 597
